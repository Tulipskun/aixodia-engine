#!/usr/bin/env bash
# AIxodia foreground launcher.
# "start" replaces this shell with aixodia-engine; output remains attached to
# the caller (Kaggle, Colab, terminal, or a process supervisor).
set -euo pipefail

AIXODIA_HOME="${AIXODIA_HOME:-$HOME/.aixodia}"
ENGINE_BIN="${AIXODIA_ENGINE_BIN:-aixodia-engine}"
LOCAL_URL="${AIXODIA_LOCAL_URL:-http://127.0.0.1:8787}"

die() {
  echo "aixodia: $*" >&2
  exit 1
}

engine_path() {
  command -v "$ENGINE_BIN" 2>/dev/null || die "engine binary '$ENGINE_BIN' not found — reinstall with the install script"
}

healthz() {
  command -v curl >/dev/null 2>&1 || die "curl is required"
  curl -fsS --max-time 5 "$LOCAL_URL/healthz" 2>/dev/null
}

health_pid() {
  printf '%s\n' "$1" |
    sed -n 's/.*"pid"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p'
}

is_engine_pid() {
  local pid="$1" exe
  [ "$pid" -gt 1 ] 2>/dev/null || return 1
  [ -r "/proc/$pid/exe" ] || return 1
  exe="$(readlink "/proc/$pid/exe" 2>/dev/null || true)"
  case "${exe##*/}" in
    aixodia-engine|aixodia-engine\ \(deleted\)) return 0 ;;
    *) return 1 ;;
  esac
}

cmd_start() {
  [ -n "${CF_TOKEN:-}" ] || die "CF_TOKEN is not set"
  local resolved
  resolved="$(engine_path)"
  command -v cloudflared >/dev/null 2>&1 || die "cloudflared not found in PATH — reinstall with the install script"

  mkdir -p "$AIXODIA_HOME" || die "cannot create $AIXODIA_HOME"
  export AIXODIA_HOME
  cd "$AIXODIA_HOME" || die "cannot enter $AIXODIA_HOME"

  echo "aixodia: starting in foreground; Ctrl-C stops the engine"
  echo "aixodia: state $AIXODIA_HOME"
  exec "$resolved"
}

cmd_status() {
  local body
  body="$(healthz)" || die "engine is not running"
  printf '%s\n' "$body"
}

cmd_stop() {
  local body pid
  body="$(healthz)" || die "engine is not running"
  pid="$(health_pid "$body")"
  [ -n "$pid" ] || die "healthz did not return an engine pid"
  is_engine_pid "$pid" || die "pid $pid is not the aixodia-engine executable"
  kill -TERM "$pid" || die "cannot send SIGTERM to pid $pid"
  echo "aixodia: SIGTERM sent to foreground engine (pid $pid)"
  echo "aixodia: the attached terminal or notebook owns the process output"
}

cmd_logs() {
  [ -n "${CF_TOKEN:-}" ] || die "CF_TOKEN is not set"
  local limit="${1:-40}"
  case "$limit" in
    ''|*[!0-9]*) die "log limit must be an integer from 1 to 2000" ;;
  esac
  [ "$limit" -ge 1 ] && [ "$limit" -le 2000 ] || die "log limit must be from 1 to 2000"
  curl -fsS --max-time 10 \
    -H "Authorization: Bearer $CF_TOKEN" \
    "$LOCAL_URL/api/logs?limit=$limit"
}

cmd_update() {
  local resolved body pid
  resolved="$(engine_path)"
  if body="$(healthz 2>/dev/null)"; then
    pid="$(health_pid "$body")"
    [ -n "$pid" ] || die "healthz did not return an engine pid"
    is_engine_pid "$pid" || die "pid $pid is not the aixodia-engine executable"
    case "$body" in
      *'"update"'*'signal:USR1'*) ;;
      *) die "the running engine does not support in-place updates; stop it with Ctrl-C and run aixodia update again" ;;
    esac
    kill -USR1 "$pid" || die "cannot request update from pid $pid"
    echo "aixodia: update requested from foreground engine (pid $pid)"
    echo "aixodia: update output remains in the engine's attached terminal"
    return 0
  fi

  "$resolved" update
}

usage() {
  cat <<'USAGE'
usage: aixodia <command>

  start       run the engine in the foreground; Ctrl-C stops it
  status      print the running engine's health
  logs [n]    print the latest n engine log entries (default 40)
  stop        send SIGTERM to the running engine
  update      update the running engine in place, or install when stopped

CF_TOKEN must be set before start. Named Tunnel credentials and URL are read from Cloudflare Workers KV.
USAGE
}

case "${1:-}" in
  ''|start|run|up) cmd_start ;;
  status) cmd_status ;;
  logs) cmd_logs "${2:-40}" ;;
  stop) cmd_stop ;;
  update) cmd_update ;;
  help|-h|--help) usage ;;
  *)
    echo "aixodia: unknown command '$1'" >&2
    usage >&2
    exit 2
    ;;
esac
