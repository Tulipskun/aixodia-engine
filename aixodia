#!/usr/bin/env bash
# AIxodia launcher.
# "start" runs the engine detached in its own session and returns.
set -euo pipefail

AIXODIA_HOME="${AIXODIA_HOME:-$HOME/.aixodia}"
ENGINE_BIN="${AIXODIA_ENGINE_BIN:-aixodia-engine}"
LOCAL_URL="${AIXODIA_LOCAL_URL:-http://127.0.0.1:8787}"
PID_FILE="${AIXODIA_PID_FILE:-aixodia.pid}"
LOG_FILE="${AIXODIA_LOG_FILE:-engine.log}"
LOG_MAX_KB="${AIXODIA_LOG_MAX_KB:-8192}"
START_WAIT="${AIXODIA_START_WAIT:-30}"
# Set to 1 to keep `start` from installing anything: the screen pane's packages
# are otherwise installed on the first start, the way cloudflared is at install
# time, so a host that was rebuilt from a bare image still shows a desktop.
# AIXODIA_SKIP_DEPENDENCIES=1
#
# The token and nothing else. Written with mode 600 by `autostart on` so the
# engine can be started by something that did not inherit an exported CF_TOKEN.
ENV_FILE="${AIXODIA_ENV_FILE:-$AIXODIA_HOME/cf.env}"
AUTOSTART_DIR="${AIXODIA_AUTOSTART_DIR:-/etc/profile.d}"

load_env() {
  # Only CF_TOKEN is read: the file may hold more for other tools, and sourcing
  # it would let a typo in somebody else's value reach the engine.
  [ -r "$ENV_FILE" ] || return 0
  [ -n "${CF_TOKEN:-}" ] && return 0
  local line value
  line="$(sed -n 's/^[[:space:]]*\(export[[:space:]]\+\)\{0,1\}CF_TOKEN=//p' "$ENV_FILE" | tail -n 1)"
  [ -n "$line" ] || return 0
  value="${line%\"}"; value="${value#\"}"
  value="${value%\'}"; value="${value#\'}"
  export CF_TOKEN="$value"
}

die() {
  echo "aixodia: $*" >&2
  exit 1
}

engine_path() {
  command -v "$ENGINE_BIN" 2>/dev/null || die "engine binary '$ENGINE_BIN' not found — reinstall with the install script"
}

healthz() {
  command -v curl >/dev/null 2>&1 || die "curl is required"
  curl -fsS --max-time 5 "$LOCAL_URL/healthz" 2>/dev/null
}

health_pid() {
  printf '%s\n' "$1" |
    sed -n 's/.*"pid"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p'
}

is_engine_pid() {
  local pid="$1" exe field
  [ "$pid" -gt 1 ] 2>/dev/null || return 1
  if [ -r "/proc/$pid/exe" ]; then
    exe="$(readlink "/proc/$pid/exe" 2>/dev/null || true)"
    case "${exe##*/}" in
      aixodia-engine|aixodia-engine\ \(deleted\)) return 0 ;;
    esac
  fi
  # An interpreter keeps the engine path in argv when it execs a script or
  # wrapper, so a launcher or test stub is still recognisable.
  if [ -r "/proc/$pid/cmdline" ]; then
    while IFS= read -r -d '' field; do
      [ "${field##*/}" = "aixodia-engine" ] && return 0
    done < "/proc/$pid/cmdline"
  fi
  return 1
}

pid_path() { printf '%s/%s\n' "$AIXODIA_HOME" "$PID_FILE"; }
log_path() { printf '%s/%s\n' "$AIXODIA_HOME" "$LOG_FILE"; }

# The engine's live pid, or nothing when it is not answering healthz.
live_pid() {
  local body pid
  body="$(healthz || true)" || body=""
  pid="$(health_pid "${body:-}")"
  [ -n "$pid" ] && is_engine_pid "$pid" && printf '%s\n' "$pid"
  return 0
}

# The pid as written, before any check on what runs under it. Used only to ask
# whether the process is still there; never signalled from here.
raw_pid() {
  local file value
  file="$(pid_path)"
  [ -r "$file" ] || return 0
  value="$(sed -n 's/^[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$file" | head -1)"
  printf '%s\n' "${value:-}"
  return 0
}

# The pid recorded by the launcher, validated against the running executable so
# a recycled pid can never be signalled.
pidfile_pid() {
  local value
  value="$(raw_pid)"
  [ -n "$value" ] && is_engine_pid "$value" && printf '%s\n' "$value"
  return 0
}

# A reaped-but-unwaited child still answers kill -0, so a zombie has to count
# as gone or a boot failure would be read as a slow start.
pid_alive() {
  local line state
  [ -r "/proc/$1/stat" ] || return 1
  line="$(cat "/proc/$1/stat" 2>/dev/null)" || return 1
  state="${line##*) }"
  [ "${state%% *}" != Z ]
}

# One generation of history is kept; the file only carries tracing and panic
# output, since `aixodia logs` reads the structured log table.
rotate_log() {
  local file size limit
  file="$(log_path)"
  [ -f "$file" ] || return 0
  size="$(wc -c < "$file" 2>/dev/null || echo 0)"
  limit=$(( LOG_MAX_KB * 1024 ))
  [ "$size" -gt "$limit" ] || return 0
  mv -f "$file" "$file.1" || die "cannot rotate $file"
  echo "aixodia: rotated $file ($size bytes) to $file.1"
}

# What the desktop is made of, when it is made of packages.
#
# The pane is a compositor this engine owns, so it asks a host for nothing at
# all. The one exception is the engine binary itself: it still links the X
# libraries for the old display, which `AIXODIA_PANE=x` selects, so without them
# it cannot even load. Those four are installed the first time the engine starts,
# exactly as cloudflared is, and never asked about again. Xvfb, xterm and the X
# fonts belong to the old pane and are installed only when it is asked for.
PANE_PACKAGES="libx11-6 libxext6 libxtst6 libxfixes3"
X_PANE_PACKAGES="xvfb xterm xfonts-base"

# True when the binary's shared libraries are all present. A script has no
# dynamic dependencies at all, which is why the test engines pass.
engine_libraries_ok() {
  ! ldd "$1" 2>/dev/null | grep -q "not found"
}

# A package manager this process may use, or nothing.
package_installer() {
  [ "${AIXODIA_SKIP_DEPENDENCIES:-0}" = "1" ] && return 1
  if [ "$(id -u)" -eq 0 ]; then
    command -v apt-get >/dev/null 2>&1 && { echo "apt-get|"; return 0; }
    command -v apk >/dev/null 2>&1 && { echo "apk|"; return 0; }
    command -v dnf >/dev/null 2>&1 && { echo "dnf|"; return 0; }
    return 1
  fi
  # Not root: only an unattended sudo counts. A password prompt in a start
  # command would hang whatever ran it.
  if command -v sudo >/dev/null 2>&1 && sudo -n true 2>/dev/null; then
    command -v apt-get >/dev/null 2>&1 && { echo "sudo apt-get|"; return 0; }
    command -v dnf >/dev/null 2>&1 && { echo "sudo dnf|"; return 0; }
  fi
  return 1
}

# True when the old display was asked for by name.
x_pane_wanted() {
  case "${AIXODIA_PANE:-}" in
    x|X|x11|X11) return 0 ;;
    *) return 1 ;;
  esac
}

ensure_pane_packages() {
  local missing="" installer="" attempt packages="$PANE_PACKAGES"
  engine_libraries_ok "$ENGINE_RESOLVED" || missing=" libraries"
  if x_pane_wanted; then
    packages="$PANE_PACKAGES $X_PANE_PACKAGES"
    command -v Xvfb >/dev/null 2>&1 || missing="$missing Xvfb"
    command -v xterm >/dev/null 2>&1 || missing="$missing xterm"
  fi
  [ -n "$missing" ] || return 0
  if ! installer="$(package_installer)"; then
    echo "aixodia: the screen pane needs$missing, and this host cannot install them." >&2
    echo "aixodia: install them yourself ($packages)" >&2
    return 0
  fi
  echo "aixodia: the screen pane needs$missing; installing $packages"
  # shellcheck disable=SC2086
  for attempt in 1 2 3; do
    case "$installer" in
      *apt-get*) ${installer%|*} update -qq >/dev/null 2>&1 || true
                 DEBIAN_FRONTEND=noninteractive ${installer%|*} install -y -qq \
                   $packages >/dev/null 2>&1 && break ;;
      *apk*)     ${installer%|*} add --no-cache $packages >/dev/null 2>&1 && break ;;
      *dnf*)     ${installer%|*} install -y -q $packages >/dev/null 2>&1 && break ;;
    esac
    echo "aixodia: install attempt $attempt failed; retrying" >&2
    sleep 5
  done
  if engine_libraries_ok "$ENGINE_RESOLVED"; then
    echo "aixodia: the screen pane's packages are in place"
  else
    echo "aixodia: the screen pane's libraries are still missing" >&2
  fi
}

require_prerequisites() {
  load_env
  [ -n "${CF_TOKEN:-}" ] || die "CF_TOKEN is not set — export it, or run 'aixodia autostart on' while it is"
  ENGINE_RESOLVED="$(engine_path)"
  command -v cloudflared >/dev/null 2>&1 || die "cloudflared not found in PATH — reinstall with the install script"
  mkdir -p "$AIXODIA_HOME" || die "cannot create $AIXODIA_HOME"
  export AIXODIA_HOME
  ensure_pane_packages
}

cmd_start() {
  local file pid raw waited gone
  require_prerequisites
  file="$(pid_path)"
  gone=0

  pid="$(live_pid)"
  if [ -n "$pid" ]; then
    printf '%s\n' "$pid" > "$file"
    echo "aixodia: engine already running (pid $pid)"
    echo "aixodia: log $(log_path)"
    return 0
  fi

  pid="$(pidfile_pid)"
  if [ -n "$pid" ]; then
    echo "aixodia: pid $pid is an engine but does not answer healthz; stopping it first"
    cmd_stop
  else
    rm -f "$file"
  fi

  rotate_log
  echo "aixodia: starting in the background; state $AIXODIA_HOME"
  AIXODIA_PID_FILE="$file" AIXODIA_LAUNCH_ENGINE="$ENGINE_RESOLVED" \
    setsid bash -c '
      pid_file="$AIXODIA_PID_FILE"
      engine="$AIXODIA_LAUNCH_ENGINE"
      state_dir="$AIXODIA_HOME"
      cd "$state_dir" || exit 1
      while IFS= read -r variable; do unset "$variable"; done < <(compgen -A variable AIXODIA_)
      unset HF_TOKEN AUTH_WORKER_URL AUTH_SYNC_SECRET ACCESS_TEAM_DOMAIN ACCESS_APP_AUD \
        ALLOWED_ORIGINS ALLOWED_GITHUB_USERS AIXODIA_MCP_UPSTREAM \
        AIXODIA_DEVICE_TUNNELS AIXODIA_TMUX GITHUB_CLIENT_ID \
        GITHUB_CLIENT_SECRET GITHUB_REDIRECT_URI
      # The engine is given a session of its own and waited for, rather than
      # reached through exec, so that its death is written down. It vanished once
      # without a line in this log —
      # no panic, no shutdown — and a status of 137 (killed) or 139 (crashed) is
      # the difference between a machine that ran out of something and a machine
      # that was shot. The pid file still names the engine, not this shell, which
      # is what `status` and `stop` are about.
      setsid "$engine" &
      child=$!
      printf "%s\n" "$child" > "$pid_file"
      wait "$child"
      echo "aixodia: engine exited with status $?"
    ' >> "$(log_path)" 2>&1 < /dev/null &

  # The child writes the pid file as soon as the engine exists, so a missing or
  # unrecognised pid here means it is still coming up. Three beats of a pid that
  # is not there at all is the engine leaving: the launcher is its parent, so an
  # exited engine can wait on as a zombie, which still answers kill -0.
  for (( waited = 0; waited < START_WAIT * 5; waited++ )); do
    if [ -n "$(live_pid)" ]; then
      pid="$(pidfile_pid)"
      echo "aixodia: engine running (pid ${pid:-$(raw_pid)}), log $(log_path)"
      return 0
    fi
    raw="$(raw_pid)"
    if [ -n "$raw" ] && ! pid_alive "$raw"; then
      gone=$(( gone + 1 ))
      [ "$gone" -ge 3 ] && break
    else
      gone=0
    fi
    sleep 0.2
  done

  # A validated pid means /proc says it is the engine, which already means alive.
  pid="$(pidfile_pid)"
  if [ -n "$pid" ]; then
    echo "aixodia: engine is still booting after ${START_WAIT}s (pid $pid); watch $(log_path)"
    return 0
  fi
  echo "aixodia: engine exited during startup; last log lines:" >&2
  tail -n 20 "$(log_path)" >&2 || true
  # A loader that could not find a library is not a crash, and the fix is a
  # package rather than a bug report: the screen pane links X, and a host without
  # it cannot load the engine at all.
  if tail -n 20 "$(log_path)" 2>/dev/null | grep -q "error while loading shared libraries"; then
    echo >&2
    echo "aixodia: a shared library the engine needs is missing, so it could not start." >&2
    echo "aixodia: the screen pane links X. Either install it:" >&2
    echo "aixodia:   apt-get install -y libx11-6 libxext6 libxtst6 libxfixes3" >&2
    echo "aixodia: or run install.sh again on this host — it picks the build" >&2
    echo "aixodia: without the screen pane when the libraries are not there." >&2
  fi
  rm -f "$file"
  exit 1
}

cmd_status() {
  local body file pid
  if body="$(healthz)"; then
    printf '%s\n' "$body"
    return 0
  fi
  file="$(pid_path)"
  if [ -r "$file" ]; then
    pid="$(raw_pid)"
    echo "aixodia: engine is not running; $file names pid ${pid:-none}" >&2
  else
    echo "aixodia: engine is not running" >&2
  fi
  exit 1
}

cmd_stop() {
  local pid source file
  file="$(pid_path)"
  pid="$(live_pid)"
  source="healthz"
  if [ -z "$pid" ]; then
    pid="$(pidfile_pid)"
    source="pidfile"
  fi
  [ -n "$pid" ] || die "engine is not running"
  kill -TERM "$pid" || die "cannot send SIGTERM to pid $pid"
  for _ in $(seq 1 100); do
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.1
  done
  if kill -0 "$pid" 2>/dev/null; then
    echo "aixodia: pid $pid (found via $source) is still alive after SIGTERM" >&2
    exit 1
  fi
  rm -f "$file"
  echo "aixodia: engine stopped (pid $pid, found via $source)"
}

cmd_logs() {
  local limit body
  limit="${1:-40}"
  case "$limit" in
    ''|*[!0-9]*) die "log limit must be an integer from 1 to 2000" ;;
  esac
  [ "$limit" -ge 1 ] && [ "$limit" -le 2000 ] || die "log limit must be from 1 to 2000"
  if [ -n "${CF_TOKEN:-}" ] && body="$(curl -fsS --max-time 10 -H "Authorization: Bearer $CF_TOKEN" "$LOCAL_URL/api/logs?limit=$limit" 2>/dev/null)"; then
    printf '%s\n' "$body"
    return 0
  fi
  [ -r "$(log_path)" ] || die "engine is not running and $(log_path) is not readable"
  echo "aixodia: reading $(log_path) (log table unavailable)"
  tail -n "$limit" "$(log_path)"
}

cmd_update() {
  local pid resolved
  if pid="$(live_pid)" && [ -n "$pid" ]; then
    case "$(healthz)" in
      *'"update"'*'signal:USR1'*) ;;
      *) die "the running engine does not support in-place updates; run aixodia stop and then aixodia update" ;;
    esac
    kill -USR1 "$pid" || die "cannot request update from pid $pid"
    echo "aixodia: update requested from engine (pid $pid)"
    echo "aixodia: the update replaces the executable image, so the pid and $(pid_path) stay valid"
    return 0
  fi

  # Installing while stopped needs the binary, not the tunnel credentials.
  resolved="$(engine_path)"
  "$resolved" update
}

# Foreground mode, for a supervisor that wants to own the process. It execs the
# engine so the supervisor's pid is the engine's, which is what makes a restart
# policy meaningful.
cmd_serve() {
  load_env
  [ -n "${CF_TOKEN:-}" ] || die "CF_TOKEN is not set"
  local engine
  engine="$(engine_path)"
  mkdir -p "$AIXODIA_HOME" || die "cannot create $AIXODIA_HOME"
  cd "$AIXODIA_HOME" || die "cannot enter $AIXODIA_HOME"
  printf '%s\n' "$$" > "$(pid_path)" 2>/dev/null || true
  exec "$engine"
}

# The hook a login shell runs. It lives in profile.d because that is the one
# directory every shell on a Debian-derived image already reads, whether or not
# there is an init system — and neither this chroot nor Termux has one.
autostart_hook() { printf '%s/aixodia-autostart.sh' "$AUTOSTART_DIR"; }

autostart_installed() { [ -r "$(autostart_hook)" ]; }

cmd_autostart() {
  local action="$1" hook
  hook="$(autostart_hook)"

  case "$action" in
    '')
      if autostart_installed; then
        echo "aixodia: autostart is on ($hook)"
      else
        echo "aixodia: autostart is off"
      fi
      [ -r "$ENV_FILE" ] && echo "aixodia: token is remembered in $ENV_FILE"
      return 0
      ;;
    on) ;;
    off) ;;
    *) die "usage: aixodia autostart on|off" ;;
  esac

  if [ "$action" = "off" ]; then
    if [ -n "${AIXODIA_SV_DIR:-}" ] && [ -d "$AIXODIA_SV_DIR/service/aixodia" ]; then
      sv down aixodia >/dev/null 2>&1 || true
      rm -rf "${AIXODIA_SV_DIR:?}/service/aixodia" "${AIXODIA_SV_DIR:?}/aixodia" 2>/dev/null || true
      echo "aixodia: runit service removed"
    fi
    rm -f "$hook" || die "cannot remove $hook"
    echo "aixodia: autostart is off"
    echo "aixodia: the engine keeps running; 'aixodia stop' ends it"
    return 0
  fi

  # Remembering the token is the part that makes an unattended start possible:
  # a login shell has no exported CF_TOKEN, so without this the hook would run
  # and fail every time.
  if [ -n "${CF_TOKEN:-}" ]; then
    mkdir -p "$(dirname "$ENV_FILE")" || die "cannot create $(dirname "$ENV_FILE")"
    umask 077
    printf 'CF_TOKEN=%s\n' "$CF_TOKEN" > "$ENV_FILE" || die "cannot write $ENV_FILE"
    chmod 600 "$ENV_FILE" || die "cannot protect $ENV_FILE"
    echo "aixodia: token saved to $ENV_FILE (mode 600)"
  elif [ -r "$ENV_FILE" ]; then
    echo "aixodia: keeping the token already in $ENV_FILE"
  else
    die "CF_TOKEN is not set and $ENV_FILE does not exist — export CF_TOKEN first"
  fi

  # runit, when it is there, is the better supervisor: it restarts an engine
  # that exits and does not depend on a shell ever opening. It is used when
  # present and skipped otherwise, since installing a supervisor is not the
  # launcher's decision to make.
  if [ -n "${AIXODIA_SV_DIR:-}" ] && [ -d "${AIXODIA_SV_DIR}" ] && command -v sv >/dev/null 2>&1; then
    install_runit_service
  fi

  mkdir -p "$AUTOSTART_DIR" || die "cannot create $AUTOSTART_DIR"
  cat > "$hook" <<EOF
# Written by 'aixodia autostart on'. Starts the engine if it is not already up.
# Silent on purpose: a login should never wait on a dead tunnel, and a shell
# that opens while the engine is still booting is not made to wait twice.
if [ -x "$(command -v aixodia 2>/dev/null || echo /usr/local/bin/aixodia)" ]; then
  if ! aixodia status >/dev/null 2>&1; then
    aixodia start >/dev/null 2>&1 || true
  fi
fi
EOF
  chmod 644 "$hook" || die "cannot install $hook"
  echo "aixodia: autostart is on ($hook)"
  echo "aixodia: the next shell that opens starts the engine if it is not running"
}

# A runit service, for hosts that run one. The run script calls the launcher
# rather than execing the engine, so the pid file and health checks stay the
# same as everywhere else.
install_runit_service() {
  local dir="$AIXODIA_SV_DIR/aixodia" link="$AIXODIA_SV_DIR/service/aixodia"
  mkdir -p "$dir" || die "cannot create $dir"
  cat > "$dir/run" <<EOF
#!/bin/sh
exec 2>&1
exec $(command -v aixodia) serve
EOF
  chmod +x "$dir/run" || die "cannot write $dir/run"
  [ -d "$AIXODIA_SV_DIR/service" ] || mkdir -p "$AIXODIA_SV_DIR/service"
  ln -sfn "$dir" "$link" || die "cannot link $link"
  sv up aixodia >/dev/null 2>&1 || true
  echo "aixodia: runit service installed at $dir"
}

usage() {
  cat <<'USAGE'
usage: aixodia <command>

  start          run the engine detached in its own session, then return
  status         print the running engine's health
  logs [n]       print the latest n log-table entries (default 40), or the
                 engine log file when the engine is not answering
  stop           send SIGTERM to the running engine and clear the pid file
  update         update the running engine in place, or install when stopped
  autostart on   remember CF_TOKEN and start the engine whenever a shell opens
  autostart off  forget it and remove that hook
  autostart      report whether the hook is installed
  serve          run the engine in this process, for a supervisor to own

CF_TOKEN must be set before start. Named Tunnel credentials and URL are read from Cloudflare Workers KV.
State, pid file (aixodia.pid) and log (engine.log) live in AIXODIA_HOME, by default ~/.aixodia.
USAGE
}

case "${1:-start}" in
  ''|start|run|up) cmd_start ;;
  status) cmd_status ;;
  logs) cmd_logs "${2:-40}" ;;
  stop) cmd_stop ;;
  update) cmd_update ;;
  autostart) cmd_autostart "${2:-}" ;;
  serve) cmd_serve ;;
  help|-h|--help) usage ;;
  *)
    echo "aixodia: unknown command '$1'" >&2
    usage >&2
    exit 2
    ;;
esac
